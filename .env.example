# ============ 小说创作助手 · 环境变量示例 ============
# 复制为 .env 后按需填写；也可改用 `codebuddy login`，或在前端「设置」页里填。

# 后端服务端口
PORT=3000

# CodeBuddy SDK 内部服务监听端口。
# 不填则后端启动时自动挑一个空闲端口（推荐）。
# 若手动指定，注意别和别的程序冲突（SDK 默认端口 56713 常被 WorkBuddy 等占用 → EADDRINUSE）。
# SERVER__PORT=48900

# 方式一：环境变量配置（API Key 与 Auth Token 至少填一个）
CODEBUDDY_API_KEY=your_api_key
# CODEBUDDY_AUTH_TOKEN=your_auth_token

# 可选：自定义网关
# CODEBUDDY_BASE_URL=https://api.example.com
# CODEBUDDY_INTERNET_ENVIRONMENT=external
